{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "size": "node scripts/check-bundle-size.mjs",
    "lhci": "lhci autorun",
    "sourcemaps:upload": "node scripts/upload-sourcemaps.mjs",
    "analyze": "node -e \"process.env.ANALYZE='1';require('child_process').execSync('npm run build',{stdio:'inherit',env:process.env})\""
  },
  "dependencies": {
    "@datadog/browser-rum": "^7.16.0",
    "@datadog/browser-rum-react": "^7.16.0",
    "@sentry/react": "^11.8.0",
    "@tanstack/react-virtual": "^3.14.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@datadog/datadog-ci": "^5.25.0",
    "@lhci/cli": "^0.15.1",
    "@sentry/vite-plugin": "^11.8.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.81.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
