# Copy to .env.local and fill in. From Datadog: Digital Experience > your RUM app > Settings
VITE_DD_APPLICATION_ID=
VITE_DD_CLIENT_TOKEN=
# datadoghq.com (US1) | us3.datadoghq.com | us5.datadoghq.com | datadoghq.eu (EU1) | ap1.datadoghq.com
VITE_DD_SITE=datadoghq.com
VITE_DD_ENV=local
VITE_APP_VERSION=dev
# true = send RUM via our /dd-proxy (ad-blocker bypass)
VITE_DD_PROXY=true

# Sentry: Project Settings > Client Keys (DSN). Public, like the DD client token
VITE_SENTRY_DSN=
